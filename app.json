{
  "expo": {
    "name": "diilzo-mobile",
    "slug": "diilzo-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "diilzomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.diilzo.mobile",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Diilzo uses the camera for product photos, barcode scanning, and video calls with sellers.",
        "NSMicrophoneUsageDescription": "Diilzo uses the microphone for voice messages and video calls with sellers.",
        "NSPhotoLibraryUsageDescription": "Diilzo needs photo library access to upload product images.",
        "NSPhotoLibraryAddUsageDescription": "Diilzo can save product images to your photo library.",
        "NSFaceIDUsageDescription": "Diilzo uses Face ID to secure your account and payments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.diilzo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#32C700",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Diilzo to access your camera for product photos, barcode scanning, and video calls.",
          "microphonePermission": "Allow Diilzo to access your microphone for voice messages and video calls."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Diilzo to access your microphone for voice messages."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Diilzo to access your microphone for voice messages.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#32C700"
        }
      ],
      "expo-video",
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://diilzo.com/api/v1",
      "eas": {
        "projectId": "b78e18af-5580-4211-9e27-0138c8d3049f"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "spiidify-2026"
  }
}
